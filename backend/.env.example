# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Comma-separated list of allowed browser origins (admin panel). Empty = none.
CORS_ORIGINS=http://localhost:3000

MONGODB_URI=mongodb://localhost:27017/cab_booking?replicaSet=rs0
# Max MongoDB connections per server instance (5-200).
# MONGO_MAX_POOL_SIZE=20
REDIS_URL=redis://localhost:6379

# Min 32 chars each. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-secret-1
JWT_REFRESH_SECRET=replace-me-with-a-long-random-secret-2

# Auth tuning (defaults shown)
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=30
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_HOUR=5

# Used only by `npm run seed`: phone of the first SUPER_ADMIN to create
SEED_ADMIN_PHONE=

# mock = in-process fake providers (blocked in production); live = real providers
PROVIDER_MODE=mock

# Staging/QA only (never in production): makes every login OTP this 6-digit code.
# STAGING_FIXED_OTP=123456

# ---- Later phases: leave empty until the credential exists. Nothing reads these yet. ----

# Phase 4: realtime + push
# REDIS_URL above; Firebase service-account JSON as a single line
# mock = log only (default). fcm = real Firebase push; also set FCM_SERVICE_ACCOUNT_JSON (one line).
PUSH_DRIVER=mock
FCM_SERVICE_ACCOUNT_JSON=

# Phase 5: real login OTPs (India needs a DLT-registered template)
# mock | nimbus. nimbus sends real texts and needs every SMS_* value below.
SMS_DRIVER=mock
SMS_OTP_MESSAGE=
SMS_ALERT_TEMPLATE_ID=
TRIP_LINK_BASE=
SMS_API_URL=
SMS_USER_ID=
SMS_PASSWORD=
SMS_SENDER_ID=
SMS_ENTITY_ID=
SMS_TEMPLATE_ID=

# Phase 5: real routes, ETAs, geocoding (server-side key)
GOOGLE_MAPS_API_KEY=

# Email (receipts, admin alerts). Optional: the app logs in by phone only
EMAIL_DRIVER=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Phase 5: driver document storage (S3 or Cloudflare R2)
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Phase 6: payments (test keys first). PAYMENTS_DRIVER=mock moves no real money;
# razorpay needs the three keys below (use TEST keys outside production).
PAYMENTS_DRIVER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Phase 8: monitoring
SENTRY_DSN=
