# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Comma-separated list of allowed browser origins (admin panel). Empty = none.
CORS_ORIGINS=http://localhost:3000

MONGODB_URI=mongodb://localhost:27017/cab_booking?replicaSet=rs0
REDIS_URL=redis://localhost:6379

# Min 32 chars each. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-secret-1
JWT_REFRESH_SECRET=replace-me-with-a-long-random-secret-2

# mock = in-process fake providers (blocked in production); live = real providers
PROVIDER_MODE=mock

# Placeholders for later phases (leave empty until credentials exist)
GOOGLE_MAPS_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
FCM_SERVICE_ACCOUNT_JSON=
SMS_PROVIDER_API_KEY=
